# Pocketbud — Fastlane
#
# Two jobs, each one command (after the API key is in place — see fastlane/README.md):
#   bundle exec fastlane beta      → build the Beta scheme + upload to TestFlight
#   bundle exec fastlane metadata  → push the App Store listing (text + screenshots), no binary
#
# Auth uses an App Store Connect API key (no 2FA prompts). Set these env vars:
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH  (path to the .p8). See README.

default_platform(:ios)

APP_ID      = "com.demarconet.weedlabel"
XCODEPROJ   = "weedlabel.xcodeproj"
DERIVED_DIR = File.expand_path("~/Library/Developer/Xcode")

def asc_api_key
  app_store_connect_api_key(
    key_id:      ENV.fetch("ASC_KEY_ID"),
    issuer_id:   ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house:    false
  )
end

platform :ios do
  before_all do
    # Foundation Models toolchain lives in the full Xcode, not CommandLineTools.
    ENV["DEVELOPER_DIR"] ||= "/Applications/Xcode.app/Contents/Developer"
  end

  desc "Build the Beta scheme and upload to TestFlight (headless, manual signing)"
  lane :beta do
    api_key = asc_api_key

    # App Manager API keys can't do Apple's *cloud* signing, but they CAN create a
    # regular Distribution cert + App Store profile. Do that into a dedicated
    # keychain with a known password so codesign never triggers a UI popup
    # (the standard CI pattern — critical for unattended runs).
    kc = "pocketbud-ci.keychain-db"
    kc_pw = ENV["MATCH_KEYCHAIN_PASSWORD"] || "pocketbud-ci-#{ENV.fetch('ASC_KEY_ID')}"
    create_keychain(
      name: kc, password: kc_pw, default_keychain: false, unlock: true,
      timeout: 3600, lock_when_sleeps: false, add_to_search_list: true
    )
    begin
      cert(api_key: api_key, development: false,
           keychain_path: File.expand_path("~/Library/Keychains/#{kc}"),
           keychain_password: kc_pw, output_path: "build/certs")
      profile_path = sigh(api_key: api_key, app_identifier: APP_ID, platform: "ios",
                          output_path: "build/profiles", force: true)
      profile_name = lane_context[SharedValues::SIGH_NAME]

      # The Beta scheme archives the Beta config (includes the #if BETA feedback
      # feature). The App Store release uses the `weedlabel` scheme / Release.
      build_app(
        project: XCODEPROJ,
        scheme: "weedlabel-Beta",
        configuration: "Beta",
        export_method: "app-store",
        output_directory: "build",
        output_name: "Pocketbud-Beta.ipa",
        export_options: {
          signingStyle: "manual",
          provisioningProfiles: { APP_ID => profile_name }
        }
      )

      upload_to_testflight(
        api_key: api_key,
        app_identifier: APP_ID,
        skip_waiting_for_build_processing: true,
        # "What to Test" — keep in sync with docs/TESTFLIGHT-RECRUITING.md §3.
        changelog: "Build 2: refreshed app icon + a cleaner look, sharper privacy " \
                   "messaging, and a fix for mis-read THCA on some flower labels. " \
                   "Scan a few real NJ labels, correct any misreads in a tap, and " \
                   "share the scan when prompted. Tell me anything off."
      )
    ensure
      delete_keychain(name: kc) rescue nil
    end
  end

  desc "Push App Store listing metadata + screenshots (no binary)"
  lane :metadata do
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      skip_binary_upload: true,
      skip_app_version_update: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false,
      force: true, # skip the HTML preview prompt (CI/headless)
      primary_category: "LIFESTYLE",
      secondary_category: "REFERENCE"
    )
  end

  desc "Verify metadata locally without uploading (lengths, assets)"
  lane :check_metadata do
    md = ->(f) { File.read(File.join(__dir__, "metadata/en-US/#{f}")).strip.length }
    limits = { "name.txt" => 30, "subtitle.txt" => 30, "keywords.txt" => 100,
               "promotional_text.txt" => 170, "description.txt" => 4000 }
    limits.each do |file, max|
      n = md.call(file)
      UI.message("#{file.ljust(20)} #{n} / #{max}  #{n <= max ? '✓' : '✗ OVER'}")
    end
    shots = Dir[File.join(__dir__, "screenshots/en-US/*.png")].count
    UI.message("screenshots:         #{shots}")
  end

  desc "Register the bundle ID via API (the app RECORD must be made in the web UI)"
  lane :make_app do
    # Apple's API allows registering a bundle ID but NOT creating an app record
    # (POST /apps is forbidden: GET/UPDATE only). So this registers the bundle ID;
    # the New App step is a manual one in App Store Connect (the bundle ID will
    # already appear in the dropdown).
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    )
    bundle = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == APP_ID }
    if bundle
      UI.success("Bundle ID registered: #{bundle.identifier} (#{bundle.id}) ✓")
    else
      bundle = Spaceship::ConnectAPI::BundleId.create(
        name: "Pocketbud", identifier: APP_ID, platform: "IOS"
      )
      UI.success("Registered bundle ID #{bundle.identifier} (#{bundle.id}) ✓")
    end
    UI.important("Now create the app record (one-time, web UI):")
    UI.important("  App Store Connect → Apps → + → New App → bundle ID #{APP_ID}")
    UI.important("Then run: fastlane auth_check")
  end

  desc "Verify the API key authenticates and report whether the app record exists"
  lane :auth_check do
    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    )
    Spaceship::ConnectAPI.token = token
    apps = Spaceship::ConnectAPI::App.all
    UI.success("✅ Authenticated. #{apps.count} app record(s):")
    apps.each { |a| UI.message("   #{a.bundle_id}  (#{a.name})") }
    if apps.any? { |a| a.bundle_id == APP_ID }
      UI.success("Pocketbud app record EXISTS for #{APP_ID} ✓")
    else
      UI.important("No app record for #{APP_ID} yet — create it, or `fastlane beta` can.")
    end
  end

  desc "Create an internal TestFlight group + add the account holder as tester"
  lane :internal_testing do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)

    group = app.get_beta_groups.find(&:is_internal_group)
    if group
      UI.message("Internal group already exists: #{group.name} (#{group.id})")
    else
      # spaceship's create_beta_group always sends publicLinkLimitEnabled, which
      # Apple rejects for internal groups. POST a clean body directly instead.
      Spaceship::ConnectAPI.test_flight_request_client.post("v1/betaGroups", {
        data: {
          type: "betaGroups",
          attributes: { name: "Internal Testers", isInternalGroup: true, hasAccessToAllBuilds: true },
          relationships: { app: { data: { id: app.id, type: "apps" } } }
        }
      })
      group = app.get_beta_groups.find(&:is_internal_group)
      UI.success("Created internal group: #{group&.name} (#{group&.id})")
    end

    begin
      Spaceship::ConnectAPI.post_beta_tester_assignment(
        beta_group_ids: [group.id],
        attributes: { firstName: "Nick", lastName: "DeMarco", email: "nickd@demarconet.com" }
      )
      UI.success("Added nickd@demarconet.com to #{group.name} ✓")
    rescue => e
      UI.important("Tester add note (may already be a member): #{e.message}")
    end

    UI.success("Internal testing ready — install TestFlight on your iPhone and accept the invite email.")
  end

  desc "Create/fetch a Distribution cert + App Store profile for manual signing (CI)"
  lane :signing do
    api_key = asc_api_key
    cert(api_key: api_key, development: false, output_path: "build/certs")
    sigh(api_key: api_key, app_identifier: APP_ID, platform: "ios",
         output_path: "build/profiles", force: true)
  end

  desc "List TestFlight builds + their processing state"
  lane :tf_status do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.success("App: #{app.name} (#{app.bundle_id})")
    builds = app.get_builds(includes: "preReleaseVersion")
    if builds.empty?
      UI.important("No builds yet — an upload can take a few minutes to appear/ingest.")
    else
      builds.first(5).each do |b|
        ver = b.pre_release_version&.version
        UI.message("  v#{ver} (build #{b.version})  state=#{b.processing_state}")
      end
    end
    groups = app.get_beta_groups
    UI.success("Beta groups (#{groups.count}):")
    groups.each do |g|
      kind = g.is_internal_group ? "INTERNAL" : "external"
      UI.message("  #{g.name} [#{kind}] id=#{g.id}")
    end
  end
end
