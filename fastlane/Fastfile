# Pocketbud — Fastlane
#
# Two jobs, each one command (after the API key is in place — see fastlane/README.md):
#   bundle exec fastlane beta      → build the Beta scheme + upload to TestFlight
#   bundle exec fastlane metadata  → push the App Store listing (text + screenshots), no binary
#
# Auth uses an App Store Connect API key (no 2FA prompts). Set these env vars:
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH  (path to the .p8). See README.

default_platform(:ios)

APP_ID      = "com.demarconet.weedlabel"
XCODEPROJ   = "weedlabel.xcodeproj"
DERIVED_DIR = File.expand_path("~/Library/Developer/Xcode")

def asc_api_key
  app_store_connect_api_key(
    key_id:      ENV.fetch("ASC_KEY_ID"),
    issuer_id:   ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house:    false
  )
end

platform :ios do
  before_all do
    # Foundation Models toolchain lives in the full Xcode, not CommandLineTools.
    ENV["DEVELOPER_DIR"] ||= "/Applications/Xcode.app/Contents/Developer"
  end

  desc "Build the Beta scheme and upload to TestFlight"
  lane :beta do
    api_key = asc_api_key

    # The Beta scheme archives the Beta config, which includes the #if BETA
    # tester-feedback feature. (The App Store release uses the `weedlabel` scheme.)
    build_app(
      project: XCODEPROJ,
      scheme: "weedlabel-Beta",
      configuration: "Beta",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Pocketbud-Beta.ipa",
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true,
      # "What to Test" — keep in sync with docs/TESTFLIGHT-RECRUITING.md §3.
      changelog: "Scan a few real NJ labels (flower/vape/edible). Check the strain, " \
                 "THC%, and terpenes against the print. Correct any misreads in a tap, " \
                 "and share the scan when prompted. Tell me anything confusing or broken."
    )
  end

  desc "Push App Store listing metadata + screenshots (no binary)"
  lane :metadata do
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      skip_binary_upload: true,
      skip_app_version_update: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false,
      force: true, # skip the HTML preview prompt (CI/headless)
      primary_category: "LIFESTYLE",
      secondary_category: "REFERENCE"
    )
  end

  desc "Verify metadata locally without uploading (lengths, assets)"
  lane :check_metadata do
    md = ->(f) { File.read(File.join(__dir__, "metadata/en-US/#{f}")).strip.length }
    limits = { "name.txt" => 30, "subtitle.txt" => 30, "keywords.txt" => 100,
               "promotional_text.txt" => 170, "description.txt" => 4000 }
    limits.each do |file, max|
      n = md.call(file)
      UI.message("#{file.ljust(20)} #{n} / #{max}  #{n <= max ? '✓' : '✗ OVER'}")
    end
    shots = Dir[File.join(__dir__, "screenshots/en-US/*.png")].count
    UI.message("screenshots:         #{shots}")
  end

  desc "Register the bundle ID via API (the app RECORD must be made in the web UI)"
  lane :make_app do
    # Apple's API allows registering a bundle ID but NOT creating an app record
    # (POST /apps is forbidden: GET/UPDATE only). So this registers the bundle ID;
    # the New App step is a manual one in App Store Connect (the bundle ID will
    # already appear in the dropdown).
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    )
    bundle = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == APP_ID }
    if bundle
      UI.success("Bundle ID registered: #{bundle.identifier} (#{bundle.id}) ✓")
    else
      bundle = Spaceship::ConnectAPI::BundleId.create(
        name: "Pocketbud", identifier: APP_ID, platform: "IOS"
      )
      UI.success("Registered bundle ID #{bundle.identifier} (#{bundle.id}) ✓")
    end
    UI.important("Now create the app record (one-time, web UI):")
    UI.important("  App Store Connect → Apps → + → New App → bundle ID #{APP_ID}")
    UI.important("Then run: fastlane auth_check")
  end

  desc "Verify the API key authenticates and report whether the app record exists"
  lane :auth_check do
    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    )
    Spaceship::ConnectAPI.token = token
    apps = Spaceship::ConnectAPI::App.all
    UI.success("✅ Authenticated. #{apps.count} app record(s):")
    apps.each { |a| UI.message("   #{a.bundle_id}  (#{a.name})") }
    if apps.any? { |a| a.bundle_id == APP_ID }
      UI.success("Pocketbud app record EXISTS for #{APP_ID} ✓")
    else
      UI.important("No app record for #{APP_ID} yet — create it, or `fastlane beta` can.")
    end
  end
end
